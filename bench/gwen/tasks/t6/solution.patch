+
+
+def test_cli_report(tmp_path, capsys):
+    p = tmp_path / "items.csv"
+    p.write_text("name,qty,price\nA,2,1.5\n")
+    assert main(["report", str(p)]) == 0
+    out, _ = capsys.readouterr()
+    assert json.loads(out) == {
+        "count": 1,
+        "low_stock": ["A"],
+        "total_qty": 2,
+        "total_value": 3.0,
+    }
