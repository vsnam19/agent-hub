#!/usr/bin/env python3
import sys
import os
import time
import json

log_dir = os.environ.get("FAKE_LOG_DIR")
if not log_dir:
    sys.exit(0)

record = {
    "argv": sys.argv,
    "stdin": sys.stdin.read() if not sys.stdin.isatty() else ""
}

filename = f"{time.time()}_{os.getpid()}.json"
with open(os.path.join(log_dir, filename), "w") as f:
    json.dump(record, f)

cmd = " ".join(sys.argv)
if "id -u" in cmd:
    print("501")
elif "launchctl print" in cmd:
    print("\tstate = running")
elif "tail -n" in cmd:
    print("log line 1\nlog line 2\nlog line 3\nlog line 4\nlog line 5")
elif "cat ~/.config/gwen/model" in cmd:
    print("qwen3.5-4b-4bit")
