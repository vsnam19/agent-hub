#!/bin/bash
# Started by launchd (dev.vsn.gwen). Serves one model, bound to the Tailscale address only.
set -euo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
# shellcheck disable=SC2155
export RAPID_MLX_API_KEY="$(cat "$HOME/.config/gwen/api-key")"
MODEL="$(head -n1 "$HOME/.config/gwen/model")"
HOST="${GWEN_HOST:-100.86.30.90}"
exec rapid-mlx serve "$MODEL" --host "$HOST" --port 8642 --yes --idle-unload-seconds 1800 --lazy-load
