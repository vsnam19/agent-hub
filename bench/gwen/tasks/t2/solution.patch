index db7dc21..d3c777f 100644
--- a/src/minilib/textstats.py
+++ b/src/minilib/textstats.py
@@ -1,3 +1,4 @@
+import re
 from collections import Counter
 
 
@@ -7,3 +8,11 @@ def word_count(text: str) -> int:
 
 def char_freq(text: str) -> dict[str, int]:
     return dict(Counter(text))
+
+
+def top_words(text: str, k: int) -> list[tuple[str, int]]:
+    if k <= 0:
+        return []
+    words = re.findall(r"[a-z0-9']+", text.lower())
+    counts = Counter(words)
+    return sorted(counts.items(), key=lambda x: (-x[1], x[0]))[:k]
