diff --git a/src/minilib/report.py b/src/minilib/report.py
new file mode 100644
index 0000000..1deb647
--- /dev/null
+++ b/src/minilib/report.py
@@ -0,0 +1,10 @@
+from minilib.inventory import low_stock, total_value
+
+
+def summarize(items) -> dict:
+    return {
+        "count": len(items),
+        "total_qty": sum(item.qty for item in items),
+        "total_value": round(total_value(items), 2),
+        "low_stock": sorted(item.name for item in low_stock(items, 5)),
+    }
