 // How often each character occurs.
 std::map<char, int> char_freq(const std::string& text);
 
+// The k most frequent words (lower-cased runs of [a-z0-9']), by count descending, then word ascending.
+std::vector<std::pair<std::string, int>> top_words(const std::string& text, int k);
