diff --git a/tests/test_report.cpp b/tests/test_report.cpp
new file mode 100644
index 0000000..1fccfc2
--- /dev/null
+++ b/tests/test_report.cpp
@@ -0,0 +1,22 @@
+#include <gtest/gtest.h>
+
+#include <string>
+#include <vector>
+
+#include "minilib/report.hpp"
+
+TEST(Report, SummarizesItems) {
+    const std::vector<minilib::Item> items = {{"Nail", 100, 0.05}, {"Screw", 3, 0.10}, {"Bolt", 1, 0.30}};
+    const minilib::Summary s = minilib::summarize(items);
+    EXPECT_EQ(s.count, 3);
+    EXPECT_EQ(s.total_qty, 104);
+    EXPECT_DOUBLE_EQ(s.total_value, 5.6);
+    EXPECT_EQ(s.low_stock, (std::vector<std::string>{"Bolt", "Screw"}));
+}
+
+TEST(Report, EmptyInventory) {
+    const minilib::Summary s = minilib::summarize({});
+    EXPECT_EQ(s.count, 0);
+    EXPECT_EQ(s.total_qty, 0);
+    EXPECT_TRUE(s.low_stock.empty());
+}
