diff --git a/src/textstats.cpp b/src/textstats.cpp
index 257eb5d..a080953 100644
--- a/src/textstats.cpp
+++ b/src/textstats.cpp
@@ -1,5 +1,6 @@
 #include "minilib/textstats.hpp"
 
+#include <algorithm>
 #include <sstream>
 
 namespace minilib {
@@ -22,4 +23,35 @@ std::map<char, int> char_freq(const std::string& text) {
     return freq;
 }
 
+std::vector<std::pair<std::string, int>> top_words(const std::string& text, int k) {
+    if (k <= 0) {
+        return {};
+    }
+    std::map<std::string, int> counts;
+    std::string word;
+    auto flush = [&]() {
+        if (!word.empty()) {
+            ++counts[word];
+            word.clear();
+        }
+    };
+    for (char c : text) {
+        if (c >= 'A' && c <= 'Z') {
+            c = static_cast<char>(c - 'A' + 'a');
+        }
+        if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '\'') {
+            word += c;
+        } else {
+            flush();
+        }
+    }
+    flush();
+    std::vector<std::pair<std::string, int>> ranked(counts.begin(), counts.end());
+    std::stable_sort(ranked.begin(), ranked.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+    if (ranked.size() > static_cast<std::size_t>(k)) {
+        ranked.resize(static_cast<std::size_t>(k));
+    }
+    return ranked;
+}
+
 }  // namespace minilib
