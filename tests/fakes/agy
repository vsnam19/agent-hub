#!/usr/bin/env python3
import json
import os
import sys
import time
import subprocess
from pathlib import Path

from _common import record_call

def get_prompt() -> str:
    try:
        p_index = sys.argv.index("-p")
        return sys.argv[p_index + 1]
    except ValueError:
        return sys.stdin.read() if not sys.stdin.isatty() else ""

def do_slow():
    subprocess.Popen(["sleep", "60"])
    time.sleep(60)

def main():
    scenario = record_call("agy")
    
    prompt = get_prompt()
    trunc_prompt = prompt[:20]

    if scenario == "ok":
        print(json.dumps({"status": "SUCCESS", "response": f"done: {trunc_prompt}"}))
        sys.exit(0)
    elif scenario == "ok-quota-text":
        print(json.dumps({"status": "SUCCESS", "response": "quota exceeded is mentioned here"}))
        sys.exit(0)
    elif scenario == "quota":
        print(json.dumps({"status": "ERROR", "error": "RESOURCE_EXHAUSTED: quota exceeded"}))
        sys.exit(1)
    elif scenario == "quota-reset":
        print(json.dumps({"status": "ERROR", "error": "RESOURCE_EXHAUSTED (code 429): Individual quota reached. Resets in 117h47m44s."}))
        sys.exit(1)
    elif scenario == "auth":
        print(json.dumps({"status": "ERROR", "error": "UNAUTHENTICATED: please sign in"}))
        sys.exit(1)
    elif scenario == "model":
        print(json.dumps({"status": "ERROR", "error": "model foo is not a known model"}))
        sys.exit(1)
    elif scenario == "empty":
        print(json.dumps({"status": "SUCCESS", "response": ""}))
        sys.exit(0)
    elif scenario == "fail":
        print("boom", file=sys.stderr)
        sys.exit(2)
    elif scenario == "slow":
        do_slow()
    elif scenario == "slow2":
        time.sleep(2)
        print(json.dumps({"status": "SUCCESS", "response": f"done: {trunc_prompt}"}))
        sys.exit(0)
    elif scenario == "write":
        Path("agent_wrote.txt").write_text("hello")
        print(json.dumps({"status": "SUCCESS", "response": f"done: {trunc_prompt}"}))
        sys.exit(0)
    elif scenario == "write-quota":
        Path("agent_wrote.txt").write_text("hello")
        print(json.dumps({"status": "ERROR", "error": "RESOURCE_EXHAUSTED: quota exceeded"}))
        sys.exit(1)
    else:
        sys.exit(1)

if __name__ == "__main__":
    main()
