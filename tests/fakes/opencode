#!/usr/bin/env python3
import sys

from _common import record_call


def main():
    scenario = record_call("opencode")
    if scenario == "ok":
        print("done")
        sys.exit(0)
    elif scenario == "context":
        print("Error: maximum context length is 32768 tokens", file=sys.stderr)
        sys.exit(1)
    elif scenario == "refused":
        print("fetch failed: ECONNREFUSED", file=sys.stderr)
        sys.exit(1)
    elif scenario == "empty":
        sys.exit(0)
    sys.exit(1)


if __name__ == "__main__":
    main()
