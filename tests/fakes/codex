#!/usr/bin/env python3
import json
import os
import sys
import time
import subprocess
from pathlib import Path

from _common import record_call

def get_out_file() -> Path | None:
    try:
        idx = sys.argv.index("-o")
        return Path(sys.argv[idx + 1])
    except ValueError:
        return None

def do_slow():
    subprocess.Popen(["sleep", "60"])
    time.sleep(60)

def main():
    scenario = record_call("codex")
    
    out_file = get_out_file()

    if scenario == "ok":
        print(json.dumps({"type": "thread.started"}))
        print(json.dumps({"type": "turn.completed"}))
        if out_file:
            out_file.write_text("done")
        sys.exit(0)
    elif scenario == "ok-quota-text":
