new file mode 100644
index 0000000..2c42031
--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,13 @@
+from minilib.inventory import Item
+from minilib.report import summarize
+
+
+def test_summarize():
+    items = [Item("A", 10, 1.0), Item("B", 2, 2.5), Item("C", 1, 3.0)]
+    res = summarize(items)
+    assert res == {
+        "count": 3,
+        "total_qty": 13,
+        "total_value": 18.0,
+        "low_stock": ["B", "C"],
+    }
