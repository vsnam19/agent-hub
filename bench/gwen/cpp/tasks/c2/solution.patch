 TEST(TextStats, CountsWords) {
@@ -21,3 +24,19 @@ TEST(TextStats, CharFreq) {
     const std::map<char, int> expected = {{'a', 2}, {'b', 1}};
     EXPECT_EQ(char_freq("aba"), expected);
 }
+
+using Ranked = std::vector<std::pair<std::string, int>>;
+
+TEST(TextStats, TopWordsRanksByCountThenWord) {
+    EXPECT_EQ(top_words("b a b c a b", 2), (Ranked{{"b", 3}, {"a", 2}}));
+    EXPECT_EQ(top_words("pear apple fig", 3), (Ranked{{"apple", 1}, {"fig", 1}, {"pear", 1}}));
+}
+
+TEST(TextStats, TopWordsLowerCasesAndSplitsOnPunctuation) {
+    EXPECT_EQ(top_words("The the, THE! it's", 5), (Ranked{{"the", 3}, {"it's", 1}}));
+}
+
+TEST(TextStats, TopWordsNonPositiveKIsEmpty) {
+    EXPECT_TRUE(top_words("a b", 0).empty());
+    EXPECT_TRUE(top_words("a b", -1).empty());
+}
