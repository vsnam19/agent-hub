--- /dev/null
+++ b/src/report.cpp
@@ -0,0 +1,19 @@
+#include "minilib/report.hpp"
+
+#include <algorithm>
+
+namespace minilib {
+
+Summary summarize(const std::vector<Item>& items) {
+    Summary s{static_cast<int>(items.size()), 0, total_value(items), {}};
+    for (const Item& item : items) {
+        s.total_qty += item.qty;
+    }
+    for (const Item& item : low_stock(items, 5)) {
+        s.low_stock.push_back(item.name);
+    }
+    std::sort(s.low_stock.begin(), s.low_stock.end());
+    return s;
+}
+
+}  // namespace minilib
