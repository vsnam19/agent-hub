        print(json.dumps({"type": "turn.completed"}))
        if out_file:
            out_file.write_text("quota exceeded is mentioned here")
        sys.exit(0)
    elif scenario == "quota":
        print(json.dumps({"type": "error", "message": "You've hit your usage limit. Try again later."}))
        sys.exit(1)
    elif scenario == "quota-reset":
        print(json.dumps({"type": "error", "message": "quota", "resets_in_seconds": 3600}))
        sys.exit(1)
    elif scenario == "auth":
        print(json.dumps({"type": "error", "message": "401 Unauthorized: not logged in"}))
        sys.exit(1)
    elif scenario == "model":
        print(json.dumps({"type": "error", "message": "model 'x' not found"}))
        sys.exit(1)
    elif scenario == "empty":
        if out_file:
            out_file.write_text("")
        sys.exit(0)
    elif scenario == "fail":
        print("boom", file=sys.stderr)
        sys.exit(2)
    elif scenario == "slow":
        do_slow()
    elif scenario == "slow2":
        time.sleep(2)
